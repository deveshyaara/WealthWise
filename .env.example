# ========================================
# DATABASE CONFIGURATION
# ========================================
# Get your Supabase database credentials from:
# Supabase Dashboard > Settings > Database > Connection String

# Connection pooling URL (for serverless environments)
DATABASE_URL="postgresql://postgres.[YOUR_SUPABASE_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations)
DIRECT_URL="postgresql://postgres.[YOUR_SUPABASE_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ========================================
# CLERK AUTHENTICATION
# ========================================
# Get your Clerk keys from: https://dashboard.clerk.com/
# Select your application > API Keys

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk Redirect URLs (do not change these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ========================================
# GOOGLE GEMINI AI
# ========================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for receipt scanning and financial insights

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ========================================
# RESEND EMAIL SERVICE
# ========================================
# Get your API key from: https://resend.com/api-keys
# Used for sending budget alerts and monthly reports

RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# ========================================
# ARCJET SECURITY
# ========================================
# Get your API key from: https://app.arcjet.com/
# Used for rate limiting and security

ARCJET_KEY=ajkey_YOUR_ARCJET_KEY_HERE

# ========================================
# INNGEST (OPTIONAL - for production)
# ========================================
# Get your keys from: https://www.inngest.com/
# Used for background jobs (recurring transactions, notifications)
# Leave empty for development - will use local dev server

# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
